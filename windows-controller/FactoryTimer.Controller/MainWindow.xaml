<Window
    x:Class="FactoryTimer.Controller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Factory Countdown Controller">

    <ScrollViewer x:Name="PageScrollViewer"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1180" Padding="28" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Factory countdown" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Timer operator control"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,20,0,0" Padding="22" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="14">
                        <TextBlock Text="Countdown" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding ControllerRemaining}" FontSize="78" FontWeight="SemiBold"
                                       FontFamily="Consolas" />
                            <TextBlock Text="MM:SS" Margin="0,0,0,13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ControllerState}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="11">
                        <TextBlock Text="Duration" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Header="Minutes" Value="{Binding DurationMinutesInput, Mode=TwoWay}"
                                       Minimum="0" Maximum="99" SmallChange="1"
                                       SpinButtonPlacementMode="Inline" />
                            <NumberBox Grid.Column="1" Header="Seconds" Value="{Binding DurationSecondsInput, Mode=TwoWay}"
                                       Minimum="0" Maximum="59" SmallChange="1"
                                       SpinButtonPlacementMode="Inline" />
                        </Grid>

                        <TextBlock Text="Panel brightness" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                    Value="{Binding BrightnessPercentInput, Mode=TwoWay}"
                                    IsEnabled="{Binding CanSend}" VerticalAlignment="Center" />
                            <NumberBox Grid.Column="1" Header="%" Minimum="0" Maximum="100" SmallChange="1"
                                       Value="{Binding BrightnessPercentInput, Mode=TwoWay}"
                                       IsEnabled="{Binding CanSend}" SpinButtonPlacementMode="Inline" />
                        </Grid>
                        <Button Content="APPLY BRIGHTNESS TO SELECTED" Click="Brightness_Click"
                                IsEnabled="{Binding CanSend}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding BrightnessStatus}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Timers" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="SELECT ALL" Click="SelectAll_Click" IsEnabled="{Binding CanSend}" />
                                <Button Content="DESELECT ALL" Click="DeselectAll_Click" IsEnabled="{Binding CanSend}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Devices}" IsEnabled="{Binding CanSend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Width="130" Margin="0,2,8,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnSpacing="12" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="START" Click="Start_Click" IsEnabled="{Binding CanSend}"
                                    HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                            <Button Grid.Column="1" Content="RESET" Click="Reset_Click"
                                    IsEnabled="{Binding CanSend}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Timers" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="350" Margin="0,0,10,10" Padding="14" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding OnlineText}" HorizontalAlignment="Right"
                                                       Foreground="{Binding OnlineBrush}" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="State" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="Remaining" Margin="12,0,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding RemainingSeconds}" FontFamily="Consolas" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,16,0,28" Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Connection" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ComboBox Header="Network interface" PlaceholderText="No usable interface selected"
                              ItemsSource="{Binding NetworkInterfaces}" SelectedItem="{Binding SelectedNetworkInterface, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding NetworkSummary}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
