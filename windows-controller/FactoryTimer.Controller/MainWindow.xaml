                            <TextBlock Grid.Row="10" Text="Remaining" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Esp05.RemainingSeconds}"/>
                            <TextBlock Grid.Row="11" Text="State" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Esp05.State}"/>
