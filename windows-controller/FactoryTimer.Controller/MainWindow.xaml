                            <TextBlock Grid.Row="15" Text="BSSID" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="15" Grid.Column="1" Text="{Binding Esp05.Bssid}" FontFamily="Consolas"/>
